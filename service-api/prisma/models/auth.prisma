/// 保存 refresh 凭据轮换链；PostgreSQL 是会话安全状态唯一权威来源。
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  securityVersion   Int       @map("security_version")
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  rotatedAt         DateTime? @map("rotated_at")
  rotatedFromId     String?   @map("rotated_from_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId, revokedAt, expiresAt])
  @@index([userId, revokedAt, createdAt, id])
  @@map("sessions")
}
