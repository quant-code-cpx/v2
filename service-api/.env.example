# Host-run defaults. Values are fake; copy to .env and replace local secrets.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://service_api:dev-only-api-postgres-password@127.0.0.1:15433/service_api
REDIS_URL=redis://:dev-only-api-redis-password@127.0.0.1:16380/0
REDIS_KEY_PREFIX=quant-v2:api
JWT_ISSUER=quant-v2
JWT_AUDIENCE=quant-v2-web
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-before-production-000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:15173
TRUST_PROXY=false
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
LOGIN_MAX_FAILURES=5
CAPTCHA_TTL_SECONDS=120
CAPTCHA_RATE_LIMIT_WINDOW_SECONDS=60
CAPTCHA_RATE_LIMIT_MAX=20
CAPTCHA_HMAC_SECRET=dev-only-captcha-hmac-secret-change-before-production-000000
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RACE_GRACE_SECONDS=5
DATA_SYNC_INTERNAL_BASE_URL=http://127.0.0.1:8000
DATA_SYNC_INTERNAL_API_BEARER_TOKEN=dev-only-data-sync-internal-bearer-token-change-before-production-000000
# 数据运维内部读取与写入使用独立服务身份；开发可临时回退，生产必须设置两项。
DATA_SYNC_INTERNAL_READ_API_BEARER_TOKEN=dev-only-data-sync-read-bearer-token-change-before-production-000000000
DATA_SYNC_INTERNAL_OPERATIONS_API_BEARER_TOKEN=dev-only-data-sync-operations-bearer-token-change-before-production-000000
DATA_SYNC_INTERNAL_REQUEST_TIMEOUT_MS=5000
# 必须大于 data-sync 的 Provider 全窗预检 deadline；提高后也要同步调整入口网关超时。
DATA_SYNC_INTERNAL_PREFLIGHT_TIMEOUT_MS=310000

# 沪深港通只读取真实已发布 bundle；完成三服务真实链路验收前保持关闭。
STOCK_CONNECT_API_ENABLED=false
# 留空时分别复用统一 data-sync 基地址和内部只读身份；拆分部署时可独立注入。
DATA_SYNC_STOCK_CONNECT_BASE_URL=
DATA_SYNC_STOCK_CONNECT_API_BEARER_TOKEN=
DATA_SYNC_STOCK_CONNECT_TIMEOUT_MS=3000
DATA_SYNC_STOCK_CONNECT_CIRCUIT_FAILURES=5
DATA_SYNC_STOCK_CONNECT_CIRCUIT_WINDOW_MS=30000
DATA_SYNC_STOCK_CONNECT_CIRCUIT_OPEN_MS=30000

# 独立 bootstrap job 仅在用户库为空且不存在 ACTIVE `SUPER_ADMIN` 时使用这两个值创建唯一超级管理员。
# 复制为 `.env` 后必须先替换占位符；生产环境通过 secret 注入，绝不提交真实凭证。
BOOTSTRAP_ADMIN_ACCOUNT=replace-with-super-admin-account
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-super-admin-password-2026
