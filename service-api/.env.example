# Host-run defaults. Values are fake; copy to .env and replace local secrets.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://service_api:dev-only-api-postgres-password@127.0.0.1:15433/service_api
REDIS_URL=redis://:dev-only-api-redis-password@127.0.0.1:16380/0
REDIS_KEY_PREFIX=quant-v2:api
JWT_ISSUER=quant-v2
JWT_AUDIENCE=quant-v2-web
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-before-production-000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:15173
TRUST_PROXY=false
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
LOGIN_MAX_FAILURES=5
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_MAX=30

# Set only for the explicit one-time bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=dev-only-bootstrap-password
