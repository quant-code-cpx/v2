# Host-run defaults. Values are fake; copy to .env and replace local secrets.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://service_api:dev-only-api-postgres-password@127.0.0.1:15433/service_api
REDIS_URL=redis://:dev-only-api-redis-password@127.0.0.1:16380/0
REDIS_KEY_PREFIX=quant-v2:api
JWT_ISSUER=quant-v2
JWT_AUDIENCE=quant-v2-web
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-before-production-000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:15173
TRUST_PROXY=false
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
LOGIN_MAX_FAILURES=5
CAPTCHA_TTL_SECONDS=120
CAPTCHA_RATE_LIMIT_WINDOW_SECONDS=60
CAPTCHA_RATE_LIMIT_MAX=20
CAPTCHA_HMAC_SECRET=dev-only-captcha-hmac-secret-change-before-production-000000
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RACE_GRACE_SECONDS=5
DATA_SYNC_INTERNAL_BASE_URL=http://127.0.0.1:8000
DATA_SYNC_INTERNAL_BEARER_TOKEN=dev-only-data-sync-internal-bearer-token-change-before-production-000000

# 独立 bootstrap job 仅在用户库为空且不存在 ACTIVE `SUPER_ADMIN` 时使用这两个值创建唯一超级管理员。
# 复制为 `.env` 后必须先替换占位符；生产环境通过 secret 注入，绝不提交真实凭证。
BOOTSTRAP_ADMIN_ACCOUNT=replace-with-super-admin-account
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-super-admin-password-2026
